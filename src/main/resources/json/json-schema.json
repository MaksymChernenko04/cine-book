{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maksymchernenko.com/cine-book/cinema-schema.json",
  "title": "CinemaData",
  "type": "object",
  "properties": {
    "cinemaData": {
      "type": "object",
      "properties": {
        "movies": {
          "type": "array",
          "items": { "$ref": "#/$defs/Movie" }
        },
        "screenings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Screening" }
        },
        "bookings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Booking" }
        }
      },
      "required": ["movies", "screenings", "bookings"],
      "additionalProperties": false
    }
  },
  "required": ["cinemaData"],
  "$defs": {
    "Movie": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "movieTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "movieDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "genre": {
          "type": "string",
          "enum": ["SCI_FI", "ANIMATION", "DRAMA", "COMEDY", "ACTION", "CRIME", "HORROR"]
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "rating": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "multipleOf": 0.1
        },
        "releaseDate": { "type": "string", "format": "date" },
        "posterURL": {
          "type": "string",
          "pattern": "^https?://.+\\.(jpg|jpeg|png|JPG|JPEG|PNG)$",
          "maxLength": 250
        }
      },
      "required": ["id", "movieTitle", "genre", "durationMinutes"],
      "additionalProperties": false
    },
    "Screening": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "movie": { "$ref": "#/$defs/Movie" },
        "startTime": { "type": "string", "format": "date-time" },
        "hall": { "$ref": "#/$defs/Hall" }
      },
      "required": ["id", "movie", "startTime", "hall"],
      "additionalProperties": false
    },
    "Hall": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "accessibility": { "type": "boolean", "default": false },
        "name": { "type": "string" },
        "capacity": { "type": "integer", "minimum": 1 },
        "seats": {
          "type": "array",
          "items": { "$ref": "#/$defs/Seat" }
        }
      },
      "required": ["id", "name", "capacity", "seats"],
      "additionalProperties": false
    },
    "Seat": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "hallId": { "type": "integer", "minimum": 1 },
        "row": { "type": "integer", "minimum": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "seatType": {
          "type": "string",
          "enum": ["REGULAR", "VIP", "ACCESSIBLE"]
        },
        "status": { "type": "string", "enum": ["AVAILABLE", "LOCKED", "SOLD"] },
        "price": { "$ref": "#/$defs/Price" },
        "lockToken": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": ["id", "hallId", "row", "number", "seatType", "status", "price"],
      "additionalProperties": false
    },
    "Price": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0.0,
          "exclusiveMaximum": 1000.0,
          "multipleOf": 0.01
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "UAH", "PLN"]
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._%+\\-]+@[a-zA-Z0-9.\\-]+\\.[A-Za-z]{2,}$",
          "maxLength": 100
        }
      },
      "required": ["name", "email"],
      "additionalProperties": false
    },
    "Payment": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "enum": ["CARD", "CASH", "ONLINE"] },
        "paidAt": { "type": "string", "format": "date-time" },
        "expectedRedirectURL": {
          "type": "string",
          "pattern": "^https?://.+",
          "maxLength": 200
        }
      },
      "required": ["method"],
      "oneOf": [
        { "required": ["paidAt"] },
        { "required": ["expectedRedirectURL"] }
      ],
      "additionalProperties": false
    },
    "Booking": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "user": { "$ref": "#/$defs/User" },
        "bookingStatus": { "type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELLED"] },
        "screening": { "$ref": "#/$defs/Screening" },
        "bookedSeats": {
          "type": "array",
          "items": { "$ref": "#/$defs/Seat" }
        },
        "totalPrice": { "$ref": "#/$defs/Price" },
        "payment": { "$ref": "#/$defs/Payment" }
      },
      "required": ["id", "user", "bookingStatus", "screening", "bookedSeats", "totalPrice"],
      "additionalProperties": false
    }
  }
}