<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://maksymchernenko.com/cine-book"
            xmlns:cd="http://maksymchernenko.com/cine-book"
            elementFormDefault="qualified">

    <!-- URL Type -->
    <xsd:simpleType name="URL">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="https?://.+"/>
            <xsd:maxLength value="200"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Image URL Type -->
    <xsd:simpleType name="ImageURL">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="https?://.+\.(jpg|jpeg|png|JPG|JPEG|PNG)"/>
            <xsd:maxLength value="250"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Title Type -->
    <xsd:simpleType name="Title">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="100"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Description Type -->
    <xsd:simpleType name="Description">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="1000"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie Genre Type -->
    <xsd:simpleType name="Genre">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="SCI_FI"/>
            <xsd:enumeration value="ANIMATION"/>
            <xsd:enumeration value="DRAMA"/>
            <xsd:enumeration value="COMEDY"/>
            <xsd:enumeration value="ACTION"/>
            <xsd:enumeration value="CRIME"/>
            <xsd:enumeration value="HORROR"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie Duration Type -->
    <xsd:simpleType name="Duration">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="1"/>
            <xsd:maxInclusive value="600"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie Rating Type -->
    <xsd:simpleType name="Rating">
        <xsd:restriction base="xsd:decimal">
            <xsd:totalDigits value="3"/>
            <xsd:fractionDigits value="1"/>
            <xsd:minExclusive value="0.0"/>
            <xsd:maxInclusive value="10.0"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Screening Price Currency Type -->
    <xsd:simpleType name="Currency">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="USD"/>
            <xsd:enumeration value="EUR"/>
            <xsd:enumeration value="UAH"/>
            <xsd:enumeration value="PLN"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Screening Price Type -->
    <xsd:simpleType name="PriceValue">
        <xsd:restriction base="xsd:decimal">
            <xsd:totalDigits value="5"/>
            <xsd:fractionDigits value="2"/>
            <xsd:minInclusive value="0.00"/>
            <xsd:maxExclusive value="1000.00"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="Price">
        <xsd:sequence>
            <xsd:element name="amount" type="cd:PriceValue"/>
        </xsd:sequence>
        <xsd:attribute name="currency" type="cd:Currency" use="required"/>
    </xsd:complexType>

    <!-- Seat Type Type -->
    <xsd:simpleType name="SeatType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="REGULAR"/>
            <xsd:enumeration value="VIP"/>
            <xsd:enumeration value="ACCESSIBLE"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Seat Status Type -->
    <xsd:simpleType name="SeatStatus">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="AVAILABLE"/>
            <xsd:enumeration value="LOCKED"/>
            <xsd:enumeration value="SOLD"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Email Type -->
    <xsd:simpleType name="Email">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[a-zA-Z0-9._%+\-]+@[a-zA-Z0-9.\-]+\.[A-Za-z]{2,}"/>
            <xsd:maxLength value="100"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Booking Status Type -->
    <xsd:simpleType name="BookingStatus">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="PENDING"/>
            <xsd:enumeration value="CONFIRMED"/>
            <xsd:enumeration value="CANCELLED"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Payment Method Type -->
    <xsd:simpleType name="PaymentMethod">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="CARD"/>
            <xsd:enumeration value="CASH"/>
            <xsd:enumeration value="ONLINE"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Token Type -->
    <xsd:simpleType name="Token">
        <xsd:restriction base="xsd:string">
            <xsd:length value="36"/>
            <xsd:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie Type -->
    <xsd:complexType name="Movie">
        <xsd:sequence>
            <xsd:element name="title" type="cd:Title"/>
            <xsd:element name="description" type="cd:Description" minOccurs="0"/>
            <xsd:element name="genre" type="cd:Genre"/>
            <xsd:element name="durationMinutes" type="cd:Duration"/>
            <xsd:element name="rating" type="cd:Rating" minOccurs="0"/>
            <xsd:element name="releaseDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="posterURL" type="cd:ImageURL" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:positiveInteger" use="required"/>
    </xsd:complexType>

    <!-- Screening Type -->
    <xsd:complexType name="Screening">
        <xsd:sequence>
            <xsd:element name="movie" type="cd:Movie"/>
            <xsd:element name="startTime" type="xsd:dateTime"/>
            <xsd:element name="hall" type="cd:Hall"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:positiveInteger" use="required"/>
    </xsd:complexType>

    <!-- Hall Type -->
    <xsd:complexType name="Hall">
        <xsd:sequence>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="capacity" type="xsd:positiveInteger"/>
            <xsd:element name="seats">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="seat" type="cd:Seat" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
        <xsd:attribute name="accessibility" type="xsd:boolean" default="false"/>
        <xsd:attribute name="id" type="xsd:positiveInteger" use="required"/>
    </xsd:complexType>

    <!-- Seat Type -->
    <xsd:complexType name="Seat">
        <xsd:all>
            <xsd:element name="row" type="xsd:positiveInteger"/>
            <xsd:element name="number" type="xsd:positiveInteger"/>
            <xsd:element name="type" type="cd:SeatType"/>
            <xsd:element name="status" type="cd:SeatStatus"/>
            <xsd:element name="price" type="cd:Price"/>
            <xsd:element name="lockToken" type="cd:Token" minOccurs="0"/>
        </xsd:all>
        <xsd:attribute name="id" type="xsd:positiveInteger" use="required"/>
        <xsd:attribute name="hallId" type="xsd:positiveInteger" use="required"/>
    </xsd:complexType>

    <!-- User Type -->
    <xsd:complexType name="User">
        <xsd:all>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="email" type="cd:Email"/>
        </xsd:all>
    </xsd:complexType>

    <!-- Payment Type -->
    <xsd:complexType name="Payment">
        <xsd:sequence>
            <xsd:element name="method" type="cd:PaymentMethod"/>
            <xsd:choice>
                <xsd:element name="paidAt" type="xsd:dateTime"/>
                <xsd:element name="expectedRedirectURL" type="cd:URL"/>
            </xsd:choice>
        </xsd:sequence>
    </xsd:complexType>

    <!-- Booking Type -->
    <xsd:complexType name="Booking">
        <xsd:sequence>
            <xsd:element name="user" type="cd:User"/>
            <xsd:element name="bookingStatus" type="cd:BookingStatus"/>
            <xsd:element name="screening" type="cd:Screening"/>
            <xsd:element name="bookedSeats">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="seat" type="cd:Seat" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="totalPrice" type="cd:Price"/>
            <xsd:element name="payment" type="cd:Payment" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:positiveInteger" use="required"/>
    </xsd:complexType>

    <!-- CinemaData Root -->
    <xsd:element name="CinemaData">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="movies">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="movie" type="cd:Movie" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>

                <xsd:element name="screenings">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="screening" type="cd:Screening" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>

                <xsd:element name="bookings">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="booking" type="cd:Booking" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
