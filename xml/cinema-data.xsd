<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://maksymchernenko.com/cine-book"
            xmlns:cd="http://maksymchernenko.com/cine-book"
            elementFormDefault="qualified">

    <!-- Movie Genre Type -->
    <xsd:simpleType name="Genre">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="SCI_FI"/>
            <xsd:enumeration value="ANIMATION"/>
            <xsd:enumeration value="DRAMA"/>
            <xsd:enumeration value="COMEDY"/>
            <xsd:enumeration value="ACTION"/>
            <xsd:enumeration value="CRIME"/>
            <xsd:enumeration value="HORROR"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie Duration Type -->
    <xsd:simpleType name="Duration">
        <xsd:restriction>
            <xsd:minInclusive value="1"/>
            <xsd:maxInclusive value="600"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie Rating Type -->
    <xsd:simpleType name="Rating">
        <xsd:restriction base="xsd:decimal">
            <xsd:totalDigits value="3"/>
            <xsd:fractionDigits value="1"/>
            <xsd:minInclusive value="0.0"/>
            <xsd:maxInclusive value="10.0"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie URL Type -->
    <xsd:simpleType name="URLType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="https?://.+\.(jpg|jpeg|png)"/>
            <xsd:maxLength value="200"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Movie Type -->
    <xsd:complexType name="Movie">
        <xsd:sequence>
            <xsd:element name="Title" type="xsd:string"/>
            <xsd:element name="Description" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Genre" type="cd:Genre"/>
            <xsd:element name="DurationMinutes" type="cd:Duration"/>
            <xsd:element name="Rating" type="cd:Rating" minOccurs="0"/>
            <xsd:element name="ReleaseDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="PosterURL" type="cd:URLType" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:positiveInteger" use="required"/>
        <xsd:attribute name="ratingSource" type="xsd:string"/>
    </xsd:complexType>

    <!-- CinemaData Root -->
    <xsd:element name="CinemaData">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="Movies">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="Movie" type="cd:Movie" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>